<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: pure black for AMOLED screens, electric blue accent. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHighlight">@color/accent_dim</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textViewStyle">@style/RG.Text</item>
    </style>

    <!-- Base for the RG.* styles below (dotted names inherit from it). -->
    <style name="RG" />

    <!-- Text -->
    <style name="RG.Text" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="RG.Text.Hero">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="RG.Text.Title">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RG.Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="RG.Text.Label">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="RG.Text.Number">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Cards -->
    <style name="RG.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
    </style>

    <!-- Buttons -->
    <style name="RG.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="RG.Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
